local add = {
	Part = function(par, a, c, col, t, s, cf)
		local p = Instance.new("Part", par)
		p.TopSurface = "Smooth" p.BottomSurface = "Smooth" p.Anchored = a p.CanCollide = c p.BrickColor = BrickColor.new(col) p.Transparency = t p.Size = s p.CFrame = cf or CFrame.new()
		local m = Instance.new("BlockMesh", p) m.Scale = Vector3.new(1, 1, 1)
		return p
	end;
	Gui = function(ins, par, bc, bg, tc, fs, text, t, s, pos)
		local g = Instance.new(ins, par)
		g.BorderColor3 = BrickColor.new(bc).Color g.BackgroundColor3 = BrickColor.new(bg).Color g.TextColor3 = BrickColor.new(tc).Color g.TextSize = 18 g.Font = Enum.Font.ArialBold g.Text = text g.BackgroundTransparency = t g.Size = s g.Position = pos
		return g
	end;
	Weld = function(par, p1, cf)
		local w = Instance.new("Weld", par)
		w.Part0 = par w.Part1 = p1 w.C1 = cf or CFrame.new()
		return w
	end;
	Mesh = function(ins, par, s, of, t, id, tid)
		local m = Instance.new(ins, par)
		m.Scale = s or Vector3.new(1, 1, 1) m.Offset = of or Vector3.new() pcall(function() m.MeshId = id or "" m.TextureId = tid or "" end)
		return m
	end;
	Sound = function(parent, id, pitch, volume)
		local s = Instance.new("Sound", parent)
		s.SoundId = id s.Volume = volume or 1 s.Pitch = pitch or 1
		return s
	end;
}

