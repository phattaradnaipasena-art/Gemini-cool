local function play(soundid, pitch)
	local sound = add.Sound(workspace, soundid, pitch or 1, 1)
	sound:Play()
	task.delay(5, function() sound:Destroy() end)
end

local function fade(part, incr)
	pcall(function()
		for i = part.Transparency, 1, incr do task.wait() part.Transparency = i end
	end)
end

local function StaticRemnant()
	play(Sounds.ElectricShortage, 1)
	play(Sounds.Abscond, 1)
	local rem = add.Part(workspace, true, false, "Bright blue", 0.25, Vector3.new(4, 4, 4), torso.CFrame * CFrame.new(0, -0.2, 0))
	add.Mesh("SpecialMesh", rem, Vector3.new(7, 7, 7), nil, nil, Meshes.Noob)
	
	rem.Touched:Connect(function(h)
		if h.Parent:FindFirstChild("Humanoid") and h.Parent ~= char then
			play(Sounds.ElectricSound, 1)
			local hHuman = h.Parent:FindFirstChild("Humanoid")
			hHuman.Health = hHuman.Health - 20
			rem:Destroy()
		end
	end)
	game.Debris:AddItem(rem, 12)
end

local function BallLightning()
	humanoid.WalkSpeed = 0
	onKey = true
	play(Sounds.Electric, 1)
	play(Sounds.ElectricSound, 1)
	
	for i = 0, 1, 0.2 do task.wait()
		animate.Torso(CFrame.Angles(-math.rad(90)*i, 0, 0))
	end
	
	local targetPos = m.Hit.p
	torso.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
	
	for i = 1, 0, -0.2 do task.wait()
		animate.Torso(CFrame.Angles(-math.rad(90)*i, 0, 0))
	end
	onKey = false
	humanoid.WalkSpeed = 16
end

